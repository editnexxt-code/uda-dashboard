# Copie este arquivo para ".env" e cole sua chave.
# Gere em https://developer.riotgames.com
# NUNCA cole a chave de verdade aqui -- este arquivo nao e protegido pelo .gitignore.
RIOT_API_KEY=RGAPI-cole-sua-chave-aqui

# Quantas partidas buscar por jogador na PRIMEIRA carga (max 100 por chamada).
MATCH_COUNT=100

# Janela de analise do dashboard, em dias. 0 = tudo que estiver no banco.
WINDOW_DAYS=90

# Minimo de partidas para um jogador entrar no ranking.
MIN_GAMES=5
